# Copy this file to .env.local for local development.
# .env.local is gitignored — never commit real API keys.

# Required: get one for free (no credit card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Optional: defaults to Gemini 3.5 Flash — free tier eligible, good balance
# of quality/latency/cost for a conversational portfolio chat. Google's model
# lineup moves fast: if you get a 404 "no longer available" or persistent 503
# "high demand" error, run `node -e` a quick generateContent test against a
# couple of candidate model names from https://aistudio.google.com and pin
# whichever responds — don't trust a model name from memory or old docs.
GEMINI_MODEL=gemini-3.5-flash
